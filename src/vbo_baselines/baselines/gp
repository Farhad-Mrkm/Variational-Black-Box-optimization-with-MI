from typing import Optional, Tuple

import torch
from torch import nn

from .common import (
    SurrogateBaseline,
    matern52,
    safe_cholesky,
    standardize_targets,
    unstandardize_targets,
)


class ExactGPBaseline(SurrogateBaseline, nn.Module):
    """
    Standard exact GP baseline with Matérn-5/2 covariance.

    TMLR configuration:
      - Matérn-5/2 kernel
      - length-scale prior Gamma(3, 6)
      - output-scale prior Gamma(2.0, 0.15)

    This implementation uses an exact marginal likelihood and is intentionally
    independent of GPyTorch/BoTorch so the core repository remains lightweight.
    """

    def __init__(
        self,
        input_dim: int,
        fit_steps: int = 300,
        learning_rate: float = 0.05,
        noise_init: float = 0.05,
        prior_lengthshape: tuple[float, float] = (3.0, 6.0),
        prior_outputscale: tuple[float, float] = (2.0, 0.15),
        jitter: float = 1e-6,
        dtype: torch.dtype = torch.float32,
        device: Optional[torch.device] = None,
    ) -> None:
        SurrogateBaseline.__init__(self)
        nn.Module.__init__(self)
        self.input_dim = input_dim
        self.fit_steps = fit_steps
        self.learning_rate = learning_rate
        self.jitter = jitter
        self.prior_lengthshape = prior_lengthshape
        self.prior_outputscale = prior_outputscale
        self.dtype = dtype
        self.device = device or torch.device("cpu")

        self.raw_log_lengthscale = nn.Parameter(torch.zeros(input_dim, dtype=dtype, device=self.device))
        self.raw_log_outputscale = nn.Parameter(torch.zeros((), dtype=dtype, device=self.device))
        self.raw_log_noise = nn.Parameter(
            torch.tensor(noise_init, dtype=dtype, device=self.device).log()
        )
        # Match BoTorch SingleTaskGP's default ConstantMean behavior.
        self.mean_offset = nn.Parameter(
            torch.zeros((), dtype=dtype, device=self.device)
        )

        self.register_buffer("_X", torch.empty(0, input_dim, dtype=dtype, device=self.device))
        self.register_buffer("_y", torch.empty(0, dtype=dtype, device=self.device))

    @property
    def lengthscale(self) -> torch.Tensor:
        return self.raw_log_lengthscale.exp().clamp_min(1e-4)

    @property
    def outputscale(self) -> torch.Tensor:
        return self.raw_log_outputscale.exp().clamp_min(1e-8)

    @property
    def noise(self) -> torch.Tensor:
        return self.raw_log_noise.exp().clamp_min(1e-6)

    def kernel(self, x1: torch.Tensor, x2: torch.Tensor) -> torch.Tensor:
        return matern52(x1, x2, self.lengthscale, self.outputscale)

    def _nll(self, X: torch.Tensor, y: torch.Tensor) -> torch.Tensor:
        K = self.kernel(X, X)
        K = K + (self.noise.square() + self.jitter) * torch.eye(
            X.shape[0], dtype=X.dtype, device=X.device
        )
        L = safe_cholesky(K, jitter=self.jitter)
        centered_y = y - self.mean_offset
        alpha = torch.cholesky_solve(centered_y[:, None], L)[:, 0]
        nll = (
            0.5 * centered_y.dot(alpha)
            + L.diagonal().log().sum()
            + 0.5 * X.shape[0] * torch.log(
                torch.tensor(2.0 * torch.pi, dtype=X.dtype, device=X.device)
            )
        )

        # Mild regularization using the paper's Gamma hyperpriors.
        lp_ls = torch.distributions.Gamma(
            self.prior_lengthshape[0], self.prior_lengthshape[1]
        ).log_prob(self.lengthscale).sum()
        lp_os = torch.distributions.Gamma(
            self.prior_outputscale[0], self.prior_outputscale[1]
        ).log_prob(self.outputscale)
        return nll - 0.01 * (lp_ls + lp_os)

    def fit(
        self,
        X: torch.Tensor,
        y: torch.Tensor,
        focal_points: Optional[torch.Tensor] = None,
    ) -> None:
        del focal_points
        X = X.to(device=self.device, dtype=self.dtype)
        y = y.to(device=self.device, dtype=self.dtype).reshape(-1)
        y_std, y_mean, y_scale = standardize_targets(y)
        self.set_target_stats(y_mean.detach(), y_scale.detach())

        # Data are stored standardized, while predictions are mapped back to
        # the original reward scale.
        self._X = X.detach()
        self._y = y_std.detach()

        optimizer = torch.optim.Adam(self.parameters(), lr=self.learning_rate)
        self.train()
        for _ in range(self.fit_steps):
            optimizer.zero_grad(set_to_none=True)
            loss = self._nll(self._X, self._y)
            loss.backward()
            optimizer.step()
            with torch.no_grad():
                self.raw_log_lengthscale.clamp_(-5.0, 5.0)
                self.raw_log_outputscale.clamp_(-5.0, 5.0)
                self.raw_log_noise.clamp_(-8.0, 1.0)

    def posterior_moments(self, X: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
        X = X.to(device=self.device, dtype=self.dtype)
        self.eval()

        K = self.kernel(self._X, self._X)
        K = K + (self.noise.square() + self.jitter) * torch.eye(
            self._X.shape[0], dtype=self.dtype, device=self.device
        )
        L = safe_cholesky(K, jitter=self.jitter)
        Kxs = self.kernel(self._X, X)
        Ksx = Kxs.T
        alpha = torch.cholesky_solve(
            (self._y - self.mean_offset)[:, None], L
        )[:, 0]
        mean_std = self.mean_offset + Ksx @ alpha
        v = torch.linalg.solve_triangular(L, Kxs, upper=False)
        Kss = self.kernel(X, X)
        covariance_std = Kss - v.T @ v
        covariance_std = 0.5 * (covariance_std + covariance_std.T)
        covariance_std = covariance_std + self.jitter * torch.eye(
            X.shape[0], dtype=self.dtype, device=self.device
        )

        mean = unstandardize_targets(mean_std, self.y_mean, self.y_scale)
        covariance = covariance_std * self.y_scale.square()
        return mean, covariance


# Alias kept for readability in configuration files.
GPBaseline = ExactGPBaseline
